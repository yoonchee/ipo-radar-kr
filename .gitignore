# Machine-local output: reports, alert dedupe state, launchd logs.
# Regenerated on every run — nothing here belongs to another machine.
state/

# Python
__pycache__/
*.py[cod]

# macOS
.DS_Store

# Machine-local config overrides (alert address, etc). Never committed;
# config.json holds only what is safe to publish.
config.local.json
